{
  "name": "excel-global-health",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prebuild": "node -e \"const fs=require('node:fs');const explicit={'17-75-slide-celex.jpg':'slide-celex.jpg','18-76-slide-ent.jpg':'slide-ent.jpg','19-77-slide-grouppharma.jpg':'slide-grouppharma.jpg','20-78-slide-rubit.jpg':'slide-rubit.jpg','21-79-slide-sorion.jpg':'slide-sorion.jpg'};const skip=new Set(['1-75-slide-celex.jpg','2-76-slide-ent.jpg','3-77-slide-grouppharma.jpg','4-78-slide-rubit.jpg','5-79-slide-sorion.jpg','6-85-gp-face-plate.png','7-86-ent-family-plate.png','8-87-ent-woman-plate.png','11-1-App.tsx','12-80-style.css','1-80-style.css','75-slide-celex.jpg','76-slide-ent.jpg','77-slide-grouppharma.jpg','78-slide-rubit.jpg','79-slide-sorion.jpg']);for(const f of fs.readdirSync('.')){if(explicit[f]){fs.copyFileSync(f,explicit[f]);continue;}if(skip.has(f))continue;const n=f.replace(/^\\\\d+-/,'');if(n!==f&&n!=='package.json')fs.copyFileSync(f,n);}\"",
    "predev": "node -e \"const fs=require('node:fs');const explicit={'17-75-slide-celex.jpg':'slide-celex.jpg','18-76-slide-ent.jpg':'slide-ent.jpg','19-77-slide-grouppharma.jpg':'slide-grouppharma.jpg','20-78-slide-rubit.jpg':'slide-rubit.jpg','21-79-slide-sorion.jpg':'slide-sorion.jpg'};const skip=new Set(['1-75-slide-celex.jpg','2-76-slide-ent.jpg','3-77-slide-grouppharma.jpg','4-78-slide-rubit.jpg','5-79-slide-sorion.jpg','6-85-gp-face-plate.png','7-86-ent-family-plate.png','8-87-ent-woman-plate.png','11-1-App.tsx','12-80-style.css','1-80-style.css','75-slide-celex.jpg','76-slide-ent.jpg','77-slide-grouppharma.jpg','78-slide-rubit.jpg','79-slide-sorion.jpg']);for(const f of fs.readdirSync('.')){if(explicit[f]){fs.copyFileSync(f,explicit[f]);continue;}if(skip.has(f))continue;const n=f.replace(/^\\\\d+-/,'');if(n!==f&&n!=='package.json')fs.copyFileSync(f,n);}\""
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
