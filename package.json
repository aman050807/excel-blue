{
  "name": "excel-global-health",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prebuild": "node -e \"const fs=require('node:fs');for(const f of fs.readdirSync('.')){const n=f.replace(/^\\d+-/,'');if(n!==f&&n!=='package.json')fs.copyFileSync(f,n)}\"",
    "predev": "node -e \"const fs=require('node:fs');for(const f of fs.readdirSync('.')){const n=f.replace(/^\\d+-/,'');if(n!==f&&n!=='package.json')fs.copyFileSync(f,n)}\""
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
